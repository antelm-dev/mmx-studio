{
  "name": "@mmx/starter-template",
  "version": "1.0.0",
  "private": true,
  "description": "MMX Studio starter project template and copy helpers.",
  "files": [
    "dist",
    "../../templates/mmx-starter"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:manifest": "node scripts/generate-manifest.mjs",
    "sync:resources": "node scripts/sync-resources.mjs"
  },
  "dependencies": {
    "@mmx/project-io": "workspace:*",
    "@mmx/project-schema": "file:../../../../.worktrees/mmx-core-assets-01/packages/project-schema"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
