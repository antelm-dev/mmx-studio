{
  "name": "mmx-studio-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "MMX Studio editor workspace.",
  "scripts": {
    "dev": "pnpm --filter @mmx/studio dev",
    "build": "turbo run build --filter=@mmx/studio",
    "typecheck": "turbo run typecheck --filter=@mmx/studio",
    "test": "turbo run test",
    "e2e": "pnpm --filter @mmx/studio e2e",
    "pack:dir": "pnpm --filter @mmx/studio pack:dir",
    "dist": "pnpm --filter @mmx/studio dist"
  },
  "devDependencies": {
    "turbo": "2.10.7",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.28.2"
}
